# ═══════════════════════════════════════════════════════════════════════════
#  Шаблон переменных окружения. Реальные значения — в .env (локально)
#  и в настройках проекта Vercel. Файл с секретами в репозиторий не попадает.
# ═══════════════════════════════════════════════════════════════════════════

# ── База данных (Supabase / PostgreSQL) ────────────────────────────────────
# Приложение ходит через транзакционный пул Supavisor (порт 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Миграции и prisma db push — сессионный режим ТОГО ЖЕ пула (порт 5432).
#
# ВАЖНО: не использовать db.<project-ref>.supabase.co — этот хост резолвится
# только в IPv6, а сборщик Vercel работает по IPv4, поэтому сборка падает с
# «Can't reach database server». Хост пулера доступен по IPv4.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Пароль подставлять без квадратных скобок: Supabase показывает строку
# с плейсхолдером [YOUR-PASSWORD], скобки — часть плейсхолдера, а не пароля.

# ── Supabase Storage ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # только на сервере, никогда не в клиенте
SUPABASE_BUCKET_MATERIALS="materials"
SUPABASE_BUCKET_SUBMISSIONS="submissions"

# ── Аутентификация (NextAuth v5) ───────────────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET="<32-байтный-секрет-hex>"
# Точный адрес развёртывания, включая схему. Локально: http://localhost:3000
AUTH_URL="https://<app>.vercel.app"
AUTH_TRUST_HOST="true"

# ── Шифрование ИИН (AES-256-GCM) ───────────────────────────────────────────
# Ровно 32 байта в base64: openssl rand -base64 32
# 32 hex-символа — это 16 байт, приложение такой ключ отвергает.
# Ключ менять нельзя: ранее зашифрованные ИИН перестанут расшифровываться.
IIN_ENCRYPTION_KEY="<32-байта-base64>"

# ── Прочее ─────────────────────────────────────────────────────────────────
MAIL_FROM="LMS <noreply@example.kz>"
PLATONUS_ENABLED="false"
CRON_SECRET="<секрет-для-эндпоинтов-/api/cron>"
SETUP_DISABLED="false"
NEXT_PUBLIC_APP_NAME="TU Courses"
