# ─────────────────────────────────────────────────────────────────────────
#  TU Online — переменные окружения. Скопируйте в .env и заполните.
#  Файл .env с реальными значениями в репозиторий не попадает.
# ─────────────────────────────────────────────────────────────────────────

# Адрес сайта (для вебхука Bunny и ссылок)
APP_URL=https://online.tashenev.edu.kz

# ── База данных PostgreSQL 16+ ────────────────────────────────────────────
# Свой сервер:        postgres://tu:ПАРОЛЬ@db:5432/tu_online
# Бесплатный стенд:   postgresql://tu_app.<project-ref>:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres@localhost:5432/tu_online
# Размер пула соединений: Vercel — 3, свой сервер — 20–40
DB_POOL_MAX=10
# Только для docker-compose: пароль базы
POSTGRES_PASSWORD=

# ── Файлы (PDF, слайды, сдачи заданий) ───────────────────────────────────
# db — в PostgreSQL (бесплатный стенд); s3 — MinIO или S3-хранилище в РК
STORAGE_DRIVER=db
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tu-online
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Предел размера загружаемого файла в браузере, МБ (Vercel — 4, свой сервер — 200)
NEXT_PUBLIC_MAX_UPLOAD_MB=4

# ── Видео: Bunny Stream (можно задать и в «Админ → Интеграции») ──────────
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=
# Секрет в адресе вебхука: https://сайт/api/bunny/webhook?secret=...
BUNNY_WEBHOOK_SECRET=

# ── Platonus API (уровень 1, после переговоров) ──────────────────────────
PLATONUS_API_URL=
PLATONUS_API_TOKEN=

# ── Расписание фоновых задач на Vercel (/api/cron/*) ─────────────────────
CRON_SECRET=

# ── Демо-режим: кнопки демо-входов на странице входа. На проде — false ──
DEMO_MODE=false
